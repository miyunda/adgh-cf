# Copy to .env beside the JSON configuration; chmod 600 .env.
# Leave all fields empty for direct downloads. HTTP mixed proxy, IPv4 only.
CANDIDATE_PROXY_ADDR=
CANDIDATE_PROXY_USERNAME=
CANDIDATE_PROXY_PASSWORD=

# Required only for run. Never put real credentials in config JSON.
ADGH_USERNAME=
ADGH_PASSWORD=
# Optional alternative to ADGH_PASSWORD; path relative to config directory.
ADGH_PASSWORD_FILE=
